{
   "name": "devfolio",
   "version": "1.0.0",
   "type": "module",
   "private": true,
   "homepage": "https://your-github-username.github.io/devfolio/",
   "scripts": {
      "dev": "vite",
      "prebuild": "pnpm validate:data",
      "build": "vite build",
      "preview": "vite preview",
      "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
      "lint:fix": "eslint . --fix",
      "format": "prettier . --write",
      "format:check": "prettier . --check",
      "test": "vitest run",
      "validate:data": "node scripts/validate-data.js",
      "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm validate:data",
      "type-check": "tsc --noEmit",
      "predeploy": "pnpm run build",
      "deploy": "gh-pages -d build",
      "clean": "rimraf build node_modules/.vite",
      "fetch:resume": "node scripts/prepare-resume.js",
      "chat-proxy": "node server/chat-proxy.mjs",
      "verify-chat": "node server/verify-chat-config.mjs"
   },
   "dependencies": {
      "@emailjs/browser": "^4.4.1",
      "@fontsource-variable/bricolage-grotesque": "^5.3.0",
      "@fontsource-variable/inter": "^5.2.8",
      "@fontsource-variable/jetbrains-mono": "^5.2.8",
      "@tailwindcss/vite": "^4.3.1",
      "cors": "^2.8.5",
      "dotenv": "^16.4.5",
      "express": "^4.21.0",
      "lenis": "^1.3.25",
      "lucide-react": "^1.40.0",
      "motion": "^13.2.0",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "react-github-calendar": "^5.0.6",
      "react-icons": "^5.6.0",
      "tailwindcss": "^4.3.1"
   },
   "devDependencies": {
      "@eslint-react/eslint-plugin": "5.18.7",
      "@eslint/js": "^10.0.1",
      "@testing-library/react": "^16.3.2",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.7",
      "@vitejs/plugin-react": "^6.0.3",
      "esbuild": "^0.28.1",
      "eslint": "^10.10.0",
      "eslint-plugin-jsx-a11y-x": "0.2.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "eslint-plugin-react-refresh": "^0.5.3",
      "gh-pages": "^6.3.0",
      "globals": "^17.7.0",
      "jsdom": "^30.0.0",
      "pdf-to-img": "^7.0.0",
      "prettier": "^3.9.1",
      "rimraf": "^6.1.3",
      "sharp": "^0.35.3",
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "typescript-7": "npm:typescript@7.0.2",
      "typescript-eslint": "^8.62.0",
      "vite": "^8.1.0",
      "vitest": "^5.0.0"
   },
   "engines": {
      "node": ">=24.11.0",
      "pnpm": ">=11.0.0"
   },
   "description": "A developer portfolio template: React + Vite + Tailwind. Edit data/*.json to make it yours.",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/your-github-username/devfolio.git"
   },
   "author": "Your Name",
   "license": "GPL-3.0",
   "bugs": {
      "url": "https://github.com/your-github-username/devfolio/issues"
   }
}
