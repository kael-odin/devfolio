# Optional analytics toggle. Set to false to skip both analytics scripts.
VITE_ANALYTICS_ENABLED=true

# EmailJS client identifiers are public browser configuration and live in
# data/contact.json with the rest of the contact content.

# ━━━ AI 分身（在线客服）━━━
# 复制本文件为 .env（勿提交 Git），填入你的模型网关配置。
# 本地调试：填好后运行 pnpm chat-proxy，再 pnpm dev，发消息即可。
# 公开部署：把同样的变量加到托管平台的环境变量里（见 docs/AI助手接入说明.md）。
#
# API Key = 模型控制台里的 API Key（Bearer 后面那一串）
# OPENCLAW_API_KEY=粘贴你的_API_Key
# 与控制台 curl 完全一致，例如火山方舟 Responses：
# OPENCLAW_CHAT_URL=https://ark.cn-beijing.volces.com/api/v3/responses
# 与 curl 里 -d 的 model 一致，例如：
# OPENCLAW_MODEL=doubao-seed-1-8-251228
# 可显式写（也可不写，只要 URL 带 /responses 会自动识别）：
# OPENCLAW_MODE=responses
#
# 可选：人设（默认见 server/chat-handler.mjs）
# OPENCLAW_SYSTEM_PROMPT=你是 Kael 的 AI 分身……
# 可选：访客问「怎么联系你」时的固定事实（每轮请求都会带上，无需训练模型）
# OPENCLAW_OWNER_FACTS=本人Kael Odin。GitHub见https://github.com/kael-odin。博客见https://kael-odin-blog.vercel.app/。
# 或多行：复制 server/owner-facts.example.txt 为 server/owner-facts.txt（已 gitignore）
# CHAT_PROXY_PORT=8790
#
# 若控制台是 /api/v3/chat/completions（messages 格式）：
# OPENCLAW_CHAT_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# OPENCLAW_MODE=openai
# OPENCLAW_MODEL=ep-xxxx（接入点 ID）
#
# 自定义网关只收 {"message":""} 时：
# OPENCLAW_MODE=simple
#
# 前端覆盖：VITE_CHAT_API_URL（公开配置，可指向你的线上 /api/chat 或本地代理）
# VITE_CHAT_API_URL=
